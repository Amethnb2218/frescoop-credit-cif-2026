# FresCoop CIF DigiCoop-WA+ 2026
# Copilote offline-first de l'agent de crédit agricole

# --- Base PostgreSQL ---
# Obligatoire pour démarrer le serveur. Ne jamais exposer cette URL au frontend.
DATABASE_URL=
# Optionnel : vraie base PostgreSQL isolée pour les tests d'intégration.
TEST_DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000

# --- Transfert ponctuel Turso -> PostgreSQL (outil CLI uniquement) ---
# Ne jamais définir ces variables côté frontend ni les committer avec une valeur.
TURSO_SOURCE_DATABASE_URL=
TURSO_SOURCE_AUTH_TOKEN=

# --- Sécurité ---
TOKEN_SECRET=
CORS_ORIGINS=

# Mots de passe initiaux : utiliser des valeurs longues et uniques en production.
DEMO_PWD=
ADMIN_DEFAULT_PWD=
JURY_PWD=

# --- Serveur ---
PORT=4174
FRESCOOP_HOST=127.0.0.1

# --- Conseil agronomique Teranga (optionnel) ---
# Hôte serveur exposant /api/ml/... ; laisser vide pour utiliser uniquement le moteur local.
TERANGA_BASE_URL=
TERANGA_TIMEOUT_MS=2500
