# FresCoop CIF DigiCoop-WA+ 2026
# Copilote offline-first de l'agent de crédit agricole

# --- Base de données ---
# Vide en dev = SQLite local (server/data/frescoop.db)
# En production: obligatoire
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Sécurité ---
TOKEN_SECRET=
CORS_ORIGINS=

# --- Serveur ---
PORT=4174
FRESCOOP_HOST=127.0.0.1

# --- Conseil agronomique Teranga (optionnel) ---
# URL racine publique, sans chemin /api et sans slash final.
# Le service doit exposer /api/ml/predict-yield/... et /api/ml/risk/....
# Exemple du service Teranga officiel : https://teranga-ai.onrender.com
TERANGA_BASE_URL=
TERANGA_TIMEOUT_MS=2500

# --- Dossiers de démonstration FresCoop (désactivé par défaut) ---
# Résout strictement un tenant et un agent actif existants ; aucun appel Teranga.
FRESCOOP_DEMO_SEED_ENABLED=false
FRESCOOP_DEMO_TENANT_CODE=
FRESCOOP_DEMO_AGENT_EMAIL=
# Obligatoire uniquement si NODE_ENV=production et le seed est activé.
FRESCOOP_DEMO_SEED_PRODUCTION_ACK=
