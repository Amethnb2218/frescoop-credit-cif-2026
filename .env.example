# FresCoop CIF DigiCoop-WA+ 2026
# Copilote offline-first de l'agent de crédit agricole

# --- Base de données ---
# Vide en dev = SQLite local (server/data/frescoop.db)
# En production: obligatoire
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Sécurité ---
TOKEN_SECRET=
CORS_ORIGINS=

# --- Serveur ---
PORT=4174
FRESCOOP_HOST=127.0.0.1

# --- Conseil agronomique Teranga ---
# Backend public officiel Teranga. Surcharger cette valeur uniquement pour utiliser une autre instance compatible.
TERANGA_BASE_URL=https://teranga-ai.onrender.com
# Le service Render peut nécessiter un démarrage à froid ; délai commun aux appels rendement, risque et rapport narratif.
TERANGA_TIMEOUT_MS=30000
